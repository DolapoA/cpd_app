# ---------------------------------------------------------------------------
# Copy to .env.local for development, and set the same names in Vercel.
# Nothing here is secret; .env.local and .env are gitignored.
# ---------------------------------------------------------------------------

# Database ------------------------------------------------------------------
# Leave both unset locally and the app uses a SQLite file at data/cpd.db.
# In production these are required: a serverless filesystem is read-only and
# wiped between invocations, so a file database cannot work there.
#   turso db create cpd-register
#   turso db show cpd-register --url
#   turso db tokens create cpd-register
# TURSO_DATABASE_URL=libsql://your-db-name-you.turso.io
# TURSO_AUTH_TOKEN=

# Optional: point local development at a different SQLite file.
# CPD_DB_PATH=data/cpd.db

# Email ---------------------------------------------------------------------
# Without RESEND_API_KEY no email is sent and links are written to the server
# log instead, which is fine locally. Password reset and email confirmation
# both depend on it in production.
# RESEND_API_KEY=
# EMAIL_FROM=CPD Register <no-reply@yourdomain>
