# ---------------------------------------------------------------------------
# Copy to .env.local for development, and set the same names in Vercel.
# .env.local and .env are gitignored; nothing here is secret.
# ---------------------------------------------------------------------------

# Database (required) --------------------------------------------------------
# Supabase: Project settings -> Database -> Connection string.
#
# Use the TRANSACTION POOLER string (port 6543) for anything serverless. A
# Vercel function is short-lived and there are many of them, so direct
# connections (port 5432) exhaust Postgres's connection limit under load.
#
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# Locally, either `supabase start` or any Postgres will do:
# DATABASE_URL=postgresql://localhost:5432/cpd_dev

# Optional: connections per instance. The default of 5 matches the widest
# fan-out a single page makes.
# PGPOOL_MAX=5

# Email ----------------------------------------------------------------------
# Without RESEND_API_KEY nothing is sent and links are written to the server log
# instead — fine locally, but in production it means silent lockouts.
# RESEND_API_KEY=
# EMAIL_FROM=CPD Register <no-reply@yourdomain>

# Where "Report a problem" goes. Deliberately not defaulted in code, because
# this repository is public and a default would put the address on GitHub.
# Unset, reports are written to the server log rather than dropped.
# FEEDBACK_TO=info@yourdomain

# Absolute origin, for canonical URLs and social images.
# Defaults to https://cpdregister.app
# NEXT_PUBLIC_SITE_URL=https://cpdregister.app

# Notifications ---------------------------------------------------------------
# Web Push, for people who have installed the app. Generate a pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
#
# The public key is handed to the browser and is not secret. The private key
# signs every notification and is. Changing either invalidates every existing
# subscription, so people would have to turn notifications on again.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:info@yourdomain

# Scheduled jobs --------------------------------------------------------------
# Both cron routes answer 404 without this, including to Vercel's own
# scheduler — so unset, nobody is reminded and nobody is notified.
#
# /api/cron/reminders runs daily and sends the day-before email.
# /api/cron/notify runs HOURLY, because the delivery hour is the person's to
# choose and a daily job cannot honour twenty-four different answers. Vercel's
# Hobby plan only runs cron once a day: on Hobby, either move the schedule to a
# single fixed hour, or point an external scheduler at the route instead.
# CRON_SECRET=
